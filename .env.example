# ============================================
# LLM Provider Configuration
# ============================================
# Choose: "ollama" (free, local) or "openai" (paid, cloud)
LLM_PROVIDER=ollama

# ============================================
# Ollama Configuration (Free & Local)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ============================================
# OpenAI Configuration (Optional - if LLM_PROVIDER=openai)
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_LLM_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# ============================================
# Confluence Configuration (Optional)
# ============================================
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=your-email@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here
# Example space keys: HR, SOP, ENG, PROD_DOCS, MKT_OPS
# Leave empty to ingest from all spaces
CONFLUENCE_SPACE_KEY=

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================
# Vector Store Settings
# ============================================
CHROMA_DB_PATH=./chroma_db
DOCUMENTS_PATH=./data/documents

# ============================================
# Gap Detection Thresholds
# ============================================
MIN_SIMILARITY_SCORE=0.3
REPEATED_QUERY_THRESHOLD=3
UNCERTAINTY_PHRASES=I'm not sure,I don't have information,I cannot find,unable to locate,no documentation found
